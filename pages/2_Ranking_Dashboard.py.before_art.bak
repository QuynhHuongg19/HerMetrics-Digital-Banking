""", unsafe_allow_html=True)



# The hero uses a separate image column: text cannot cover the buffalo cart.

art_html = f'<img src="{art}" alt="Tranh làng quê Việt Nam: người nông dân và xe trâu">' if art else '<div class="hm-r-hero-art-empty"></div>'

st.markdown(f'''<div class="hm-r-hero">

<div class="hm-r-hero-copy">

<div class="hm-r-eyebrow">HERMETRICS / BANKING INTELLIGENCE</div>

<div class="hm-r-title">Digital Transformation<br>Ranking 2025</div>

<div class="hm-r-sub">Xếp hạng chuyển đổi số ngân hàng thương mại Việt Nam · Dữ liệu BDTI ước tính</div>

</div><div class="hm-r-hero-art">{art_html}</div></div>''', unsafe_allow_html=True)

if not art:

    st.warning("Chưa tìm thấy ảnh xe trâu. Đặt ranking_lang_que.jpg trong assets/vietnam_art/.")



left, right = st.columns([2, 1])

with left:

    selected = st.multiselect("Ngân hàng", full["bank"].tolist(), default=full["bank"].tolist(), key="ranking_selected_banks")

with right:

    mode = st.selectbox("Chế độ hiển thị", ["Tổng quan", "Chi tiết 4 trụ cột"], key="ranking_mode")

df = full[full["bank"].isin(selected)].sort_values("BDTI", ascending=False).reset_index(drop=True)

if df.empty:

    st.info("Hãy chọn ít nhất một ngân hàng để hiển thị bảng xếp hạng.")

    st.stop()



metrics = [

    ("Số ngân hàng", f"{len(df)}", "Ngân hàng đang hiển thị", "#fff2e7"),

    ("BDTI cao nhất", f"{df['BDTI'].max():.3f}", "Thang điểm 100", "#e2f2ed"),

    ("BDTI trung bình", f"{df['BDTI'].mean():.3f}", "Trung bình nhóm được chọn", "#fff1c9"),

    ("Trụ cột đánh giá", "04", "A · B · C · D", "#eaf1df"),

]

cols = st.columns(4, gap="medium")

for col, (label, val, note, bg) in zip(cols, metrics):

    with col:

        st.markdown(f'<div class="hm-r-kpi" style="background:{bg}"><div class="hm-r-kpi-label">{label}</div><div class="hm-r-kpi-value">{val}</div><div class="hm-r-kpi-note">{note}</div></div>', unsafe_allow_html=True)



st.markdown('<div class="hm-r-section">🏆 Leading Banks</div>', unsafe_allow_html=True)

top_cols = st.columns(3, gap="medium")

for idx, col in enumerate(top_cols):

    with col:

        if idx >= len(df):

            st.empty()

            continue

        item = df.iloc[idx]

        name = str(item["bank"])

        score = float(item["BDTI"])

        color = BANK_COLORS.get(name, TEAL)

        logo = LOGO_DIR / f"{name}.jpg"

        logo_html = f'<img src="{image_uri(logo)}" alt="{escape(name)}" style="height:42px;max-width:130px;object-fit:contain;margin-top:8px">' if logo.is_file() else ""

        st.markdown(f'''<div class="hm-r-top"><div class="hm-r-medal">{'🥇' if idx == 0 else '🥈' if idx == 1 else '🥉'} TOP {idx+1} · HẠNG {idx+1} TRONG NHÓM ĐANG CHỌN</div>{logo_html}

<div class="hm-r-bank">{escape(name)}</div><div class="hm-r-score">{score:.3f}</div><div style="font-size:11px;color:#73808a">BDTI / 100</div>

<div class="hm-r-progress"><div style="width:{min(max(score,0),100)}%;background:{color}"></div></div></div>''', unsafe_allow_html=True)



st.markdown('<div class="hm-r-section">Ranking Analytics</div>', unsafe_allow_html=True)

c1, c2 = st.columns([1.12, 1], gap="medium")

with c1:

    st.markdown('<div class="hm-r-panel-title">Overall BDTI Ranking</div><div class="hm-r-panel-note">Xếp hạng theo điểm BDTI / 100 · Dữ liệu ranking.csv</div>', unsafe_allow_html=True)

    rev = df.iloc[::-1]

    fig = go.Figure(go.Bar(x=rev["BDTI"], y=rev["bank"], orientation="h", marker_color=[BANK_COLORS.get(n, TEAL) for n in rev["bank"]], text=[f"{v:.3f}" for v in rev["BDTI"]], textposition="outside", hovertemplate="%{y}: %{x:.3f}<extra></extra>"))

    fig.update_layout(height=355, margin=dict(l=12,r=60,t=18,b=35), paper_bgcolor="rgba(0,0,0,0)", plot_bgcolor="rgba(0,0,0,0)", font=dict(family="Arial",size=13,color=NAVY), xaxis=dict(range=[0,108],title="BDTI / 100",gridcolor="#eee9e4",zeroline=False), yaxis=dict(title=""), showlegend=False)

    st.plotly_chart(fig, use_container_width=True, config={"displayModeBar":False})

with c2:

    st.markdown('<div class="hm-r-panel-title">Pillar Performance</div><div class="hm-r-panel-note">Điểm theo 4 trụ cột của ngân hàng được chọn</div>', unsafe_allow_html=True)

    radar_bank = st.selectbox("Ngân hàng phân tích", df["bank"].tolist(), key="ranking_radar_bank")

    row = df.loc[df["bank"] == radar_bank].iloc[0]

    labels = ["A · Chiến lược", "B · Sản phẩm", "C · Công nghệ", "D · Vận hành"]

    vals = [float(row[p]) if pd.notna(row[p]) else 0 for p in "ABCD"]

    radar = go.Figure(go.Scatterpolar(r=vals+[vals[0]], theta=labels+[labels[0]], fill="toself", line=dict(color=BURGUNDY,width=3), fillcolor="rgba(121,12,52,.18)", marker=dict(size=7,color=BURGUNDY), name=radar_bank))

    radar.update_layout(height=315, margin=dict(l=45,r=45,t=20,b=25), paper_bgcolor="rgba(0,0,0,0)", showlegend=False, font=dict(size=12,color=NAVY), polar=dict(bgcolor="rgba(0,0,0,0)", radialaxis=dict(visible=True,range=[0,100],tickvals=[25,50,75,100],gridcolor="#e9e2df"), angularaxis=dict(gridcolor="#e9e2df")))

    st.plotly_chart(radar, use_container_width=True, config={"displayModeBar":False})



st.markdown('<div class="hm-r-section">Dimension Comparison</div>', unsafe_allow_html=True)

if mode == "Chi tiết 4 trụ cột":

    st.caption("So sánh điểm từng trụ cột của các ngân hàng được chọn")

fig2 = go.Figure()

for bank in df["bank"]:

    values = df.loc[df["bank"] == bank, list("ABCD")].iloc[0].tolist()

    fig2.add_bar(name=bank, x=["A · Chiến lược", "B · Sản phẩm", "C · Công nghệ", "D · Vận hành"], y=values, marker_color=BANK_COLORS.get(bank, TEAL), hovertemplate=f"{escape(bank)} · %{{x}}: %{{y:.1f}}<extra></extra>")

fig2.update_layout(barmode="group", height=340, margin=dict(l=10,r=15,t=25,b=55), paper_bgcolor="rgba(0,0,0,0)", plot_bgcolor="rgba(0,0,0,0)", font=dict(size=12,color=NAVY), yaxis=dict(range=[0,105],title="Điểm / 100",gridcolor="#ede8e4"), legend=dict(orientation="h",y=1.18,x=0))

st.plotly_chart(fig2, use_container_width=True, config={"displayModeBar":False})



st.markdown('<div class="hm-r-section">Detailed Ranking</div>', unsafe_allow_html=True)

table = df[["bank","BDTI","A","B","C","D"]].copy()

table.insert(0,"Hạng trong nhóm", range(1,len(table)+1))

table.columns = ["Hạng", "Ngân hàng", "BDTI", "Trụ cột A", "Trụ cột B", "Trụ cột C", "Trụ cột D"]

for col in ["BDTI","Trụ cột A","Trụ cột B","Trụ cột C","Trụ cột D"]:

    table[col] = table[col].map(lambda v: f"{v:.3f}" if pd.notna(v) else "—")

st.dataframe(table, use_container_width=True, hide_index=True, height=min(410, 42*(len(table)+1)+12))



leader = df.iloc[0]

st.markdown('<div class="hm-r-section">Một số nhận định từ dữ liệu</div>', unsafe_allow_html=True)

st.markdown(f'''<div class="hm-r-insight">• <b>{escape(str(leader['bank']))}</b> dẫn đầu nhóm ngân hàng đang chọn với <b>{float(leader['BDTI']):.3f}/100</b> điểm BDTI.<br>

• Điểm trung bình của <b>{len(df)}</b> ngân hàng đang hiển thị là <b>{df['BDTI'].mean():.3f}/100</b>.<br>

• Khoảng cách giữa ngân hàng có điểm cao nhất và thấp nhất trong nhóm là <b>{df['BDTI'].max()-df['BDTI'].min():.3f}</b> điểm.<br>

• Các điểm số là kết quả <b>ước tính từ quy trình chấm tự động</b>, không phải xếp hạng chính thức đã được kiểm định độc lập.</div>''', unsafe_allow_html=True)

st.markdown(f'<div class="hm-r-footer">HerMetrics · Digital Transformation Ranking 2025 · Nguồn dữ liệu: {escape(str(csv_path.relative_to(ROOT)))} · Không suy diễn xu hướng theo năm khi chưa có dữ liệu lịch sử.</div>', unsafe_allow_html=True)
