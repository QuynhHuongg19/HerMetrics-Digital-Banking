"""HerMetrics — Ranking Dashboard 2025 (isolated page).

Copy to pages/2_Ranking_Dashboard.py. Requires pandas, streamlit, plotly.

Reads real data/ranking.csv; does not modify any other page.

"""

from __future__ import annotations



import base64

from html import escape

from pathlib import Path



import pandas as pd

import streamlit as st

import plotly.graph_objects as go



st.set_page_config(page_title="Ranking Dashboard | HerMetrics", page_icon="🏆", layout="wide", initial_sidebar_state="expanded")

# HERMETRICS_SIDEBAR_V2
from pathlib import Path as _HMPath
from hermetrics_sidebar import render as _hm_render
_hm_render(_HMPath(__file__).resolve().parent.parent, show_nav=True)


ROOT = Path(__file__).resolve().parents[1]

DATA_CANDIDATES = [ROOT / "data" / "ranking.csv", ROOT / "output" / "ranking.csv"]

ART_CANDIDATES = [

    ROOT / "assets" / "vietnam_art" / "ranking_lang_que.jpg",

    ROOT / "assets" / "vietnam_art" / "ranking_lang_que.png",

    ROOT / "assets" / "vietnam_art" / "lang_que_viet_nam.png",

]

LOGO_DIR = ROOT / "assets" / "logos"

BURGUNDY, TEAL, GOLD, NAVY = "#790C34", "#167A73", "#D59A24", "#213747"

BANK_COLORS = {"OCB":"#93A92B", "MB":"#285ED5", "BIDV":"#E1A92D", "VietinBank":"#58A7D8", "VCB":"#168D70"}

PILLARS = {"A":"A · Chiến lược & nguồn lực số", "B":"B · Sản phẩm số & trải nghiệm KH", "C":"C · Công nghệ & dữ liệu", "D":"D · Vận hành số & an toàn"}



@st.cache_data(show_spinner=False)

def read_csv(path: str, stamp: float) -> pd.DataFrame:

    frame = pd.read_csv(path, encoding="utf-8-sig")

    frame.columns = frame.columns.str.strip()

    needed = ["bank", "BDTI", "A", "B", "C", "D"]

    missing = [c for c in needed if c not in frame.columns]

    if missing:

        raise ValueError("ranking.csv thiếu các cột: " + ", ".join(missing))

    frame["bank"] = frame["bank"].astype(str).str.strip()

    frame["bank"] = frame["bank"].replace({"Vietinbank":"VietinBank", "VTB":"VietinBank"})

    for col in ["BDTI", "A", "B", "C", "D"]:

        frame[col] = pd.to_numeric(frame[col], errors="coerce")

    return frame.dropna(subset=["bank", "BDTI"]).sort_values("BDTI", ascending=False).reset_index(drop=True)



def image_uri(path: Path) -> str:

    if not path.is_file():

        return ""

    mime = "image/jpeg" if path.suffix.lower() in (".jpg", ".jpeg") else "image/png"

    return f"data:{mime};base64,{base64.b64encode(path.read_bytes()).decode('ascii')}"



csv_path = next((p for p in DATA_CANDIDATES if p.is_file()), None)

if csv_path is None:

    st.error("Không tìm thấy ranking.csv. Hãy đặt file tại data/ranking.csv (hoặc output/ranking.csv) trong dự án.")

    st.stop()

try:

    full = read_csv(str(csv_path), csv_path.stat().st_mtime)

except Exception as exc:

    st.error(f"Không đọc được ranking.csv: {exc}")

    st.stop()



art_path = next((p for p in ART_CANDIDATES if p.is_file()), None)

art = image_uri(art_path) if art_path else ""



st.markdown("""

<style>

